{
  "name": "feishu-cursor-bot",
  "version": "0.1.0",
  "license": "MIT",
  "private": true,
  "type": "module",
  "description": "Feishu long-connection bot that drives Cursor agents via @cursor/sdk",
  "bin": {
    "feishu-cursor-bot": "./bin/feishu-cursor-bot.mjs"
  },
  "files": [
    "bin",
    "src",
    "assets",
    "README.md",
    "LICENSE",
    ".env.example"
  ],
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@cursor/sdk": "^1.0.0",
    "@larksuiteoapi/node-sdk": "^1.55.0",
    "dotenv": "^16.6.1",
    "tsx": "^4.20.3"
  },
  "devDependencies": {
    "@types/node": "^22.17.0",
    "typescript": "^5.9.2"
  }
}
